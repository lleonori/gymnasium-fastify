{
  "name": "gymnasium-fastify",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsc --noEmit && NODE_ENV=development FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --import tsx/esm --watch src src/index.ts",
    "build": "tsc",
    "postbuild": "cp package*.json dist/ && cp postgrator-config.js dist/ && cp .env.production dist/ && cp -rf migrations dist/",
    "pm2:start": "NODE_ENV=production pm2 start index.js --name gymnasium",
    "db:up": "docker compose --env-file .env.development up -d",
    "db:migrate": "postgrator --config postgrator-config.js",
    "db:down": "docker compose down",
    "generate:db:types": "kysely-codegen --camel-case --env-file=.env.development",
    "pg-pull": "docker pull postgres:$(grep POSTGRES_VERSION .env.development | cut -d '=' -f2)-alpine",
    "pretest": "npm run pg-pull",
    "test": "vitest",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/auth": "^5.1.0",
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "auth0": "^6.4.0",
    "change-case": "^5.4.4",
    "desm": "^1.3.1",
    "env-schema": "^8.0.0",
    "fastify": "^5.12.3",
    "fastify-auth0-verify": "^4.1.4",
    "fastify-plugin": "^6.0.0",
    "fs-extra": "^11.4.0",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "qs": "^6.16.0",
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dockerode": "^4.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.15.1",
    "@vitest/coverage-v8": "^5.0.0",
    "close-with-grace": "^2.5.0",
    "dockerode": "^5.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "kysely-codegen": "^0.20.0",
    "lefthook": "^2.1.12",
    "pino-pretty": "^13.1.3",
    "postgrator-cli": "^10.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
